# Copy to .env on the server: cp env.example .env

# Domain Caddy requests the HTTPS certificate for. Its DNS must point at the server.
DOMAIN=example.com

# Inlined at build time: rebuild the image after changing these
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_APP_NAME=Northfid

NEXTAUTH_URL=https://example.com
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Bearer token for POST /api/prices/update. Leave empty to disable the endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET=
